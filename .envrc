# Auto-loaded by direnv when you cd into this directory (or a subdirectory).
# Runs `direnv allow` once after creating/changing this file.

# Use the project-local uv venv (Ansible lives here) if it exists.
# PATH_add is a direnv helper: it prepends to PATH and is removed when you leave.
if [ -d .venv ]; then
  PATH_add .venv/bin
fi

# Export the variables from .env without ever committing it.
if [ -f .env ]; then
  set -a
  source .env
  set +a
fi
