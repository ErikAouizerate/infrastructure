# Copy this file to .env and fill in your values. Never commit .env.

# Hetzner Cloud API token (read natively by the hcloud provider via HCLOUD_TOKEN)
HCLOUD_TOKEN=

# Name of the SSH key registered in Hetzner Cloud (maps to var.ssh_key_name)
TF_VAR_ssh_key_name=

# Public SSH key for the admin user created by cloud-init (maps to
# var.admin_ssh_public_key). Command substitution keeps it in sync with the
# key file:
# TF_VAR_admin_ssh_public_key="$(cat ~/.ssh/id_rsa.pub)"
TF_VAR_admin_ssh_public_key=

# Admin CIDR(s) allowed to reach SSH on the firewall (maps to var.ssh_allowed_ips).
# JSON list of strings; single-quote the whole value so the shell keeps the quotes:
# TF_VAR_ssh_allowed_ips='["1.2.3.4/32"]'
TF_VAR_ssh_allowed_ips=

# Tailscale auth key used by the firewall and app servers to join the tailnet
TS_AUTHKEY=

DOKPLOY_URL=
DOKPLOY_API_KEY=